# Copy to .env (never commit .env). All values are optional; defaults are shown.

# duckdb (default, offline) | fabric (optional, read-only SQL analytics endpoint)
DEMO_BACKEND=duckdb

# deterministic (default, no live LLM) | ollama (optional local model, narration only)
NARRATOR=deterministic

# Runtime state directory for the local DuckDB lakehouse replica (gitignored).
DEMO_STATE_DIR=.demo-state

# Optional Fabric SQL analytics endpoint (read-only). No passwords: Microsoft Entra
# interactive authentication is used. Copy the server name from the Lakehouse
# SQL analytics endpoint settings ("SQL connection string").
FABRIC_SQL_SERVER=
FABRIC_SQL_DATABASE=AIPlatform
FABRIC_USER=
FABRIC_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Optional Ollama narrator (local only).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
